@model ErrorViewModel
@{ ViewData["Title"] = "No se pudo procesar la solicitud"; }
<section class="shell detail-section"><div class="empty-state"><h1>No se pudo procesar la solicitud</h1><p>Intenta nuevamente. Si el problema continúa, comunica el identificador de la solicitud al encargado.</p>@if (Model.ShowRequestId) { <p>Identificador: <code>@Model.RequestId</code></p> }<a class="button" asp-controller="Home" asp-action="Index">Volver al inicio</a></div></section>
