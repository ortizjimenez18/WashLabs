@model WashLabs.Models.DTOs.VehiculoDTO
@{ ViewData["Title"] = $"Vehículo {Model.Matricula}"; }
<section class="shell page-heading"><h1>Detalle del vehículo</h1></section>
<section class="shell detail-section">
    @if (TempData["Mensaje"] is string mensaje) { <p class="notice" role="status">@mensaje</p> }
    <article class="loyalty-card vehicle-detail-card">
        <header class="loyalty-card-header"><img src="~/images/marca/washlabs.png" asp-append-version="true" alt="WashLabs" width="1672" height="941" /><span>VEHÍCULO</span></header>
        <div class="loyalty-card-body">
            <div class="loyalty-identity"><div><span class="meta-label">Placa</span><h2>@Model.Matricula</h2><p class="muted">@Model.Marca @Model.Modelo</p></div></div>
            <dl class="vehicle-detail-data">
            <dt>Cliente</dt><dd>@Model.Cliente</dd>
            <dt>Año</dt><dd>@(Model.Anio?.ToString() ?? "No registrado")</dd>
            <dt>Color</dt><dd>@(string.IsNullOrWhiteSpace(Model.Color) ? "No registrado" : Model.Color)</dd>
            <dt>Tamaño</dt><dd>@(Model.CategoriaTamano switch { "PEQUENO" => "Pequeño", "MEDIANO" => "Mediano", "GRANDE" => "Grande", "PICKUP" => "Pick-up", "OTRO" => "Otro", _ => Model.CategoriaTamano })</dd>
            </dl>
            <div class="detail-actions"><a class="button" asp-action="Editar" asp-route-id="@Model.VehiculoId">Editar vehículo</a><a class="text-link" asp-action="Index">Volver al listado</a></div>
        </div>
    </article>
</section>
