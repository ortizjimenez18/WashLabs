@model IReadOnlyList<WashLabs.Models.DTOs.VehiculoDTO>
@{ ViewData["Title"] = "Vehículos"; }
<section class="shell page-heading"><p class="eyebrow">WASHLABS / CLIENTES</p><h1>Vehículos registrados</h1><p class="lede">Cada matrícula conserva su propio historial de lavados.</p></section>
<section class="shell history-section">
@if (TempData["Mensaje"] is string mensaje) { <p class="notice" role="status">@mensaje</p> }
<div class="section-heading"><a class="button" asp-action="Crear">Registrar vehículo</a><a class="text-link" asp-controller="WashPoints" asp-action="Index">Consultar WashPoints </a></div>
@if (Model.Count == 0) { <div class="empty-state"><h2>No hay vehículos registrados.</h2></div> }
else { <div class="document-panel table-wrap" role="region" aria-label="Vehículos" tabindex="0"><table class="invoice-lines"><caption>Vehículos por cliente</caption><thead><tr><th scope="col">Matrícula</th><th scope="col">Cliente</th><th scope="col">Marca y modelo</th><th scope="col">Año</th></tr></thead><tbody>
@foreach (var vehiculo in Model) { <tr><td>@vehiculo.Matricula</td><td>@vehiculo.Cliente</td><td>@vehiculo.Marca @vehiculo.Modelo</td><td>@(vehiculo.Anio?.ToString() ?? "No registrado")</td></tr> }
</tbody></table></div> }
</section>
