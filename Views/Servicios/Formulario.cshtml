@model WashLabs.Models.ViewModels.ServicioFormulario
@{ ViewData["Title"] = Model.ServicioId == 0 ? "Crear servicio" : "Editar servicio"; }
@section Styles { <link rel="stylesheet" href="~/css/avance4.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/servicios.css" asp-append-version="true" /> }
<section class="shell history-section servicios-modulo">
    <nav class="servicio-breadcrumb" aria-label="Ruta de navegación"><a asp-action="Index">Servicios</a><span aria-hidden="true">/</span><span>@ViewData["Title"]</span></nav>
    <h1>@ViewData["Title"]</h1>
    <form class="document-panel a4-form servicio-form" asp-action="@(Model.ServicioId == 0 ? "Crear" : "Editar")" asp-route-id="@(Model.ServicioId == 0 ? (int?)null : Model.ServicioId)" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="ServicioId" type="hidden" />
        <fieldset><legend>Información general</legend><div class="servicio-campos">
            <div><label asp-for="Nombre">Nombre del servicio</label><input asp-for="Nombre" maxlength="120" required /><span asp-validation-for="Nombre"></span></div>
            <div><label asp-for="TipoLavado">Tipo de lavado</label><select asp-for="TipoLavado" required><option value="">Seleccione un tipo</option><option value="EXTERIOR">Exterior</option><option value="INTERIOR">Interior</option><option value="COMPLETO">Completo</option><option value="PROTECCION">Protección</option></select><span asp-validation-for="TipoLavado"></span></div>
            <div class="servicio-ancho"><label asp-for="Descripcion">Descripción</label><textarea asp-for="Descripcion" rows="3" maxlength="700" required></textarea><span asp-validation-for="Descripcion"></span></div>
        </div></fieldset>
        <fieldset><legend>Precio y duración</legend><div class="servicio-campos servicio-tres">
            <div><label asp-for="TarifaBase">Tarifa en colones (₡)</label><input asp-for="TarifaBase" type="number" min="0.01" step="0.01" required /><span asp-validation-for="TarifaBase"></span></div>
            <div><label asp-for="DuracionMinutos">Duración en minutos</label><input asp-for="DuracionMinutos" type="number" min="1" step="1" required /><span asp-validation-for="DuracionMinutos"></span></div>
            <div><label asp-for="NivelDetalle">Nivel de detalle</label><select asp-for="NivelDetalle"><option value="BASICO">Básico</option><option value="INTERMEDIO">Intermedio</option><option value="PROFUNDO">Profundo</option><option value="PREMIUM">Premium</option></select><span asp-validation-for="NivelDetalle"></span></div>
        </div></fieldset>
        <fieldset><legend>Imagen del servicio</legend><div class="servicio-carga" data-servicio-carga>
            <div class="servicio-preview">
                <partial name="_ServicioImagen" model="@(new WashLabs.Models.DTOs.ServicioDTO(Model.ServicioId, Model.Nombre, Model.Descripcion, Model.TarifaBase, Model.DuracionMinutos, Model.ImagenUrl))" />
                <img data-servicio-preview hidden alt="Vista previa de la imagen seleccionada" width="450" height="300" />
            </div>
            <div><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 6-6 4 4 3-3 5 5"/></svg>
                <label for="imagen">Seleccionar imagen del servicio</label>
                <div class="servicio-selector"><label class="servicio-seleccionar" for="imagen">Seleccionar o cambiar imagen</label><input id="imagen" name="imagen" type="file" required="@(Model.ServicioId == 0)" accept="image/png,image/jpeg,image/webp" aria-describedby="imagen-ayuda imagen-nombre imagen-error" /></div>
                <p id="imagen-nombre" data-servicio-archivo aria-live="polite">@(Model.ImagenUrl is null ? "Ningún archivo seleccionado" : "Imagen actual del servicio")</p>
                <p id="imagen-ayuda">PNG, JPG/JPEG o WEBP. Máximo 2 MB. Puede cambiar la selección antes de guardar. Al editar sin seleccionar un archivo, se conserva la imagen actual.</p>
                <span id="imagen-error" class="field-validation-error">@Html.ValidationMessage("imagen")</span>
            </div>
        </div></fieldset>
        <fieldset><legend>Disponibilidad</legend><div class="servicio-activo"><input asp-for="Activo" /><label asp-for="Activo">Activo</label></div><p class="servicio-ayuda">Los servicios inactivos no se ofrecen en el catálogo público.</p></fieldset>
        <div class="servicio-acciones"><button type="submit" class="button">Guardar servicio</button><a class="servicio-cancelar" asp-action="Index">Cancelar</a></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/servicios.js" asp-append-version="true"></script> }
