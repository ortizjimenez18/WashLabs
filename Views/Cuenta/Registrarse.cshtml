@model WashLabs.Models.DTOs.RegistroCuentaDTO
@{ ViewData["Title"] = "Crear cuenta"; }
<section class="shell page-heading"><p class="eyebrow">MI WASHLABS</p><h1>Crear cuenta</h1></section>
<section class="shell detail-section"><form method="post" asp-action="Registrarse" class="document-panel registration-form"><div asp-validation-summary="All" class="validation-errors" role="alert"></div><div class="form-grid"><div><label asp-for="Nombre">Nombre completo</label><input asp-for="Nombre" autocomplete="name" maxlength="150" required /></div><div><label asp-for="Identificacion">Identificación</label><input asp-for="Identificacion" maxlength="30" required /></div><div><label asp-for="Correo">Correo electrónico</label><input asp-for="Correo" type="email" autocomplete="username" maxlength="150" required /></div><div><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono" type="tel" autocomplete="tel" maxlength="25" required /></div><div><label asp-for="FechaNacimiento">Fecha de nacimiento</label><input asp-for="FechaNacimiento" type="date" asp-format="{0:yyyy-MM-dd}" min="1900-01-01" max="@DateOnly.FromDateTime(WashLabs.Models.DTOs.DisponibilidadReserva.Ahora).ToString("yyyy-MM-dd")" required /></div><div><label asp-for="Direccion">Dirección</label><input asp-for="Direccion" autocomplete="street-address" maxlength="300" required /></div><div><label asp-for="Clave">Contraseña</label><div class="password-field"><input asp-for="Clave" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /><button type="button" data-toggle-password="Clave" aria-label="Mostrar contraseña" aria-pressed="false">Mostrar</button></div><p class="form-helper">Entre 12 y 128 caracteres.</p></div><div><label asp-for="ConfirmarClave">Repite la contraseña</label><input asp-for="ConfirmarClave" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></div></div><div class="detail-actions"><button class="button" type="submit">Crear cuenta</button><a class="text-link" asp-action="Entrar">Ya tengo cuenta</a></div></form></section>
