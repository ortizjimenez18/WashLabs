@model IReadOnlyList<WashLabs.Models.DTOs.CategoriaAsistenteDTO>
@{ ViewData["Title"] = "Asistente"; }
<section class="shell page-heading"><p class="eyebrow">WASHLABS / INFORMACIÓN</p><h1>¿En qué podemos ayudarte?</h1><p class="lede">Selecciona un tema y consulta las respuestas del asistente guiado.</p></section>
<section class="shell history-section assistant-topics">
@if (Model.Count == 0) { <div class="empty-state"><h2>No hay temas disponibles.</h2></div> }
@foreach (var categoria in Model) {
<article class="assistant-topic"><div><h2>@categoria.Nombre</h2>@if (!string.IsNullOrWhiteSpace(categoria.Descripcion)) { <p>@categoria.Descripcion</p> }</div>
@if (categoria.PreguntaInicialId.HasValue) { <a class="text-link" asp-action="Pregunta" asp-route-id="@categoria.PreguntaInicialId">Consultar tema </a> }
else { <span class="muted">Sin preguntas disponibles</span> }
</article> }
</section>
