<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The web project lives at the repository root; sibling layers own their files. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);WashLabs.Data/**;WashLabs.Models/**;WashLabs.Services/**;WashLabs/**</DefaultItemExcludes>
    <UserSecretsId>84cd4722-f2f7-45ff-80bb-b95a43666266</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="WashLabs.Services\WashLabs.Services.csproj" />
    <ProjectReference Include="WashLabs.Models\WashLabs.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="docs\" />
    <Folder Include="ViewModels\" />
    <Folder Include="Mappers\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
